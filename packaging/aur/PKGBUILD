# Maintainer: Vrushabh <https://github.com/itsvrushabh>
pkgname=rs-budget-git
_pkgname=rs-budget
pkgver=0.1.0.r0.g418233e
pkgrel=1
pkgdesc="Privacy-first, local-first envelope budgeting suite in 100% Rust (Actual Budget rewrite)"
arch=('x86_64' 'aarch64')
url="https://github.com/itsvrushabh/rs-budget"
license=('MIT')
depends=('gcc-libs' 'glibc' 'openssl' 'sqlite')
makedepends=('cargo' 'git')
provides=('rs-budget' 'actual' 'actual-tui' 'actual-desktop' 'actual-server')
conflicts=('rs-budget' 'actual' 'actual-tui' 'actual-desktop' 'actual-server')
source=("git+https://github.com/itsvrushabh/rs-budget.git")
sha256sums=('SKIP')

pkgver() {
    cd "${srcdir}/${_pkgname}"
    git describe --long --tags --always 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' || printf "0.1.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    cd "${srcdir}/${_pkgname}"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "${srcdir}/${_pkgname}"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --release --frozen --bins
}

check() {
    cd "${srcdir}/${_pkgname}"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --release --frozen --bins
}

package() {
    cd "${srcdir}/${_pkgname}"

    # Install binaries
    install -Dm755 "target/release/actual" "${pkgdir}/usr/bin/actual"
    install -Dm755 "target/release/actual-tui" "${pkgdir}/usr/bin/actual-tui"
    install -Dm755 "target/release/actual-desktop" "${pkgdir}/usr/bin/actual-desktop"
    install -Dm755 "target/release/actual-server" "${pkgdir}/usr/bin/actual-server"

    # Install desktop entries
    install -Dm644 "packaging/desktop/actual.desktop" "${pkgdir}/usr/share/applications/actual.desktop"
    install -Dm644 "packaging/desktop/actual-tui.desktop" "${pkgdir}/usr/share/applications/actual-tui.desktop"

    # Install AppStream metadata
    install -Dm644 "packaging/desktop/com.actualbudget.actual.metainfo.xml" "${pkgdir}/usr/share/metainfo/com.actualbudget.actual.metainfo.xml"

    # Install icon
    install -Dm644 "packaging/desktop/actual-budget.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/actual-budget.svg"

    # Install license
    install -Dm644 "Cargo.toml" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
